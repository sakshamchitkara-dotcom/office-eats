# Required by the Nominatim/Overpass usage policies: identify your app + contact.
OFFICE_EATS_USER_AGENT="office-eats/0.1 (you@example.com)"
# Optional: Claude blurbs + shortlist (deterministic fallback when unset)
ANTHROPIC_API_KEY=
# Optional official venue APIs (only used when set and selected with --provider)
GOOGLE_PLACES_API_KEY=
YELP_API_KEY=
FOURSQUARE_API_KEY=
# Optional: OpenRouteService key for --routing ors (--routing osrm needs no key)
ORS_API_KEY=
# Optional: where polls, votes, teams and rotation history live
# OFFICE_EATS_DB=~/.local/share/office-eats/data.sqlite3
# Optional: Slack incoming webhook + slash-command signing secret
SLACK_WEBHOOK_URL=
SLACK_SIGNING_SECRET=
